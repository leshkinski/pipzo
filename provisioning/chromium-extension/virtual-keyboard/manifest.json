{
  "manifest_version": 3,
  "name": "Pipzo Touch Keyboard",
  "version": "0.1.3",
  "description": "First-party Pipzo touch keyboard and Spotify session reset helper for true kiosk setup.",
  "permissions": ["browsingData", "cookies", "scripting"],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "https://*.spotify.com/*"
  ],
  "background": {
    "service_worker": "pipzo-session-reset.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1:8000/*",
        "http://localhost:8000/*",
        "https://accounts.spotify.com/*"
      ],
      "js": ["pipzo-keyboard.js"],
      "css": ["pipzo-keyboard.css"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ]
}
