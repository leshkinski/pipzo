# Pipzo Chromium kiosk runtime environment.
# Install script copies this to /etc/pipzo/kiosk.env only when that file is absent.

PIPZO_KIOSK_URL=http://127.0.0.1:8000/
PIPZO_CHROMIUM_PROFILE=.local/share/pipzo/chromium-profile
# kiosk is the V1 product default: true fullscreen with no OS panel or window chrome.
# app-maximized is diagnostic-only because it can expose OS panel/window chrome.
PIPZO_CHROMIUM_MODE=kiosk
# First-party local extension keyboard for true-kiosk setup input.
PIPZO_CHROMIUM_EXTENSION_DIR=/opt/pipzo/app/provisioning/chromium-extension/virtual-keyboard
# Optional diagnostic-only Chromium switches. Leave empty for normal runtime.
PIPZO_CHROMIUM_EXTRA_FLAGS=
